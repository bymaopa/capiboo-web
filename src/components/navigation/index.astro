---
const arrLink = [
	{ id: 101, name: 'Dashboard', route: '/', icon: '/src/assets/icons/nav/dashboard-svgrepo-com.svg', type: 'bottom' },
	{ id: 103, name: 'Search', route: '/search', icon: '/src/assets/icons/nav/search-alt-2-svgrepo-com.svg', type: 'bottom' },
	{ id: 102, name: 'Notes', route: '/registry', icon: '/src/assets/icons/nav/bookmark-svgrepo-com.svg', type: 'bottom' },
	{ id: 104, name: 'Notify', route: '/notify', icon: '/src/assets/icons/nav/bell-svgrepo-com.svg' },
	{ id: 105, name: 'Settings', route: '/settings', icon: '/src/assets/icons/nav/setting-1-svgrepo-com.svg' },
];

const { pathname } = Astro.url;
---

<nav
	class="fixed bottom-0 left-0 right-0 z-50 backdrop-blur-3xl m-0 pb-12 pt-6 transition-all duration-300 ease-in-out lg:relative lg:left-auto lg:top-auto lg:bottom-auto lg:z-auto lg:bg-transparent lg:p-6"
>
	<div class="flex h-full flex-row items-center justify-center align-middle lg:justify-start gap-x-14 lg:flex-col lg:gap-y-4">
		<!-- User - Component -->
		<div class="w-18 h-18 hidden lg:block">
			<img class="h-auto w-auto block object-center drop-shadow-xl" src="/src/assets/logo.webp" alt="fi_capiboo" />
		</div>
		<!-- Menu Section -->
		<ul class="lg:h-full flex flex-row gap-x-14 lg:flex-col lg:gap-y-6 lg:pb-6 justify-center items-center lg:justify-center lg:items-center">
			{
				arrLink.map((el) => (
					<li
						id={`nav-item-${el.name.toLowerCase()}`}
						class:list={[
							'w-[64px] h-[64px] md:w-[66px] md:h-[66px] lg:h-[68px] lg:w-[68px] rounded-[16px] transition-transform transform-gpu duration-150 ease-in-out hover:bg-slate-400/10',
							{ 'hidden lg:block': el.type !== 'bottom' },
							{ 'bg-black rounded-full': pathname === el.route },
						]}
					>
						<a
							id={`nav-route-${el.name.toLowerCase()}`}
							href={el.route}
							class="flex h-full w-full transform items-center justify-center rounded-[16px] p-3 transition-transform duration-100 ease-in-out hover:scale-105"
						>
							<img
								id={`nav-icon-${el.name.toLowerCase()}`}
								class:list={['h-auto w-auto bg-transparent object-center dark:brightness-0 dark:invert', { 'brightness-0 invert': pathname === el.route }]}
								src={el.icon}
								alt={el.name}
							/>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>
